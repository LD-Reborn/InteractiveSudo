{
  "webhooker_url": "http://localhost:8080",
  "bot_name": "mybot",
  "api_key_file": "/etc/interactivesudo/api_key",
  "socket_path": "/run/interactivesudo/agent.sock",
  "socket_group": "operator",
  "state_dir": "/var/lib/interactivesudo",
  "poll_interval_s": 1.5,
  "wait_timeout_s": 600,
  "remind_after_s": 300,
  "remind_mxid": "@you:matrix.example.com",
  "command_timeout_s": 300,
  "max_output_chars": 20000,
  "max_pending": 5,
  "approve_url": "wss://approve.example.com/ws/v1/client",
  "approve_psk_file": "/etc/interactivesudo/approve_psk",
  "approve_user": "operator",
  "approve_ttl_s": 300,
  "approve_remind_s": 180,
  "fallback_matrix_approve": false,
  "denylist": [
    "mkfs",
    "dd if=",
    ":() {",
    "rm -rf /",
    "rm -rf /*",
    "> /dev/sd",
    "shred /dev/"
  ]
}
